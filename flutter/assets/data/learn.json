,"ثلاث نجيمات خافتة، تحتاج عيون حادة عشان تشوفها!"],["الثريا","الكثيرة","عنقود نجوم صغيرة متلاصقة مثل حبات اللؤلؤ، من أجمل ما في السماء."],["الدبران","الذي يتبع","نجم أحمر لامع، سمّوه الدبران لأنه يمشي «دُبُر» الثريا ويلحقها."],["الهقعة","الدائرة","ثلاث نجيمات متقاربة فوق كتف صورة الجبّار."],["الهنعة","الانحناء","نجمان في صورة التوأمين، يظهران وقت اشتداد الحر."],["الذراع","ذراع الأسد","نجمان لامعان، تخيّلتهم العرب ذراعًا ممدودة."],["النثرة","أنف الأسد","لطخة ضوء خفيفة، هي في الحقيقة عنقود نجوم بعيد."],["الطرف","عين الأسد","نجمان صغيران، كأنهما نظرة الأسد."],["الجبهة","جبهة الأسد","أربعة نجوم، ألمعها «قلب الأسد»."],["الزبرة","كاهل الأسد","نجمان على ظهر الأسد مثل الشعر الكثيف."],["الصرفة","الانصراف","سمّوها الصرفة لأن الحر ينصرف ويبدأ الجو يلطف عند طلوعها."],["العوّاء","التي تعوي","خمسة نجوم على شكل حرف مائل."],["السماك","المرتفع","نجم أزرق لامع اسمه السماك الأعزل، من ألمع نجوم السماء."],["الغفر","الغطاء","ثلاث نجيمات خافتة كأنها مغطّاة."],["الزبانى","قرنا العقرب","نجمان لامعان، تخيّلتهم العرب قرون العقرب."],["الإكليل","التاج","ثلاثة نجوم على رأس العقرب مثل التاج."],["القلب","قلب العقرب","نجم أحمر عملاق اسمه قلب العقرب، أكبر من الشمس بمئات المرات!"],["الشولة","ذيل العقرب","نجمان في ذيل العقرب المرفوع."],["النعائم","النعام","ثمانية نجوم، تخيّلتها العرب نعامًا ترد الماء."],["البلدة","الأرض الخالية","مكان في السماء ما فيه نجوم لامعة، مثل أرض فاضية."],["سعد الذابح","السعد الأول","نجمان متقاربان، وهو أول «السعود»."],["سعد بلع","السعد البالع","نجمان، كأن أحدهما يبلع الآخر من قربه."],["سعد السعود","أسعد السعود","سمّوه كذا لأن وقته يبشّر بالخير والمطر."],["سعد الأخبية","سعد الخيام","أربعة نجوم مثل خيمة صغيرة."],["الفرغ المقدّم","مقدّم الدلو","نجمان لامعان، أول دلو الماء."],["الفرغ المؤخّر","مؤخّر الدلو","نجمان يكمّلان صورة الدلو."],["الرشاء","حبل الدلو","نجوم على شكل حبل، وتسمّى أيضًا «بطن الحوت»."]],"planets":[{"n":"عطارد","e":"Mercury","c":["#C9C2B8","#8A8178"],"s":16,"d":"٥٨ مليون كم","sz":"أصغر من الأرض بحوالي ٣ مرات","day":"١٧٦ يومًا من أيامنا!","yr":88,"mo":"ما له أقمار","t":"من ١٨٠- إلى ٤٣٠ درجة","r":0.38,"f":["أقرب كوكب للشمس وأصغر الكواكب.","ما عنده هواء يحميه، فنهاره حار جدًا وليله بارد جدًا.","سطحه مليان حفر مثل قمرنا."]},{"n":"الزهرة","e":"Venus","c":["#FFE0A3","#E3A857"],"s":24,"d":"١٠٨ ملايين كم","sz":"تقريبًا بحجم الأرض","day":"أطول من سنتها! ٢٤٣ يومًا","yr":225,"mo":"ما لها أقمار","t":"حوالي ٤٦٥ درجة","r":0.95,"f":["أسخن كوكب في المجموعة الشمسية، أسخن حتى من عطارد! لأن هواءها الكثيف يحبس الحرارة.","أشد الكواكب لمعانًا في سمائنا، تبان مثل نجمة قوية عند الغروب أو قبل الفجر.","تدور حول نفسها بالعكس، فالشمس عندها تطلع من الغرب!"]},{"n":"الأرض","e":"Earth","c":["#6CC6FF","#2E7FD1"],"s":25,"land":1,"d":"١٥٠ مليون كم","sz":"هذا مقياسنا 😊","day":"٢٤ ساعة","yr":365,"mo":"قمر واحد","t":"معتدلة، تقريبًا ١٥ درجة","r":1,"f":["بيتنا الجميل، والكوكب الوحيد اللي نعرف فيه حياة.","أغلبها ماء، لذلك تبان زرقاء من الفضاء.","يحيطها غلاف جوي مثل البطانية، يحمينا ويعطينا الهواء."]},{"n":"المريخ","e":"Mars","c":["#FF9A6B","#C4492A"],"s":19,"d":"٢٢٨ مليون كم","sz":"نصف حجم الأرض تقريبًا","day":"٢٤ ساعة و٣٧ دقيقة","yr":687,"mo":"قمران صغيران","t":"بارد، حوالي ٦٠- درجة","r":0.53,"f":["الكوكب الأحمر، لونه من غبار يشبه الصدأ.","فيه أعلى جبل في المجموعة الشمسية، أعلى من إيفرست بحوالي ٣ مرات.","العلماء أرسلوا له سيارات روبوت تستكشفه."]},{"n":"المشتري","e":"Jupiter","c":["#F3D3A8","#C98B5A"],"s":50,"bands":1,"d":"٧٧٨ مليون كم","sz":"أعرض من الأرض ١١ مرة!","day":"١٠ ساعات بس","yr":4333,"mo":"أكثر من ٩٠ قمرًا","t":"بارد جدًا، حوالي ١١٠- درجة","r":11.2,"f":["أكبر الكواكب، يتسع لأكثر من ألف كوكب مثل الأرض!","فيه «البقعة الحمراء العظيمة»، عاصفة ضخمة أكبر من الأرض.","كوكب غازي، يعني ما فيه أرض نمشي عليها."]},{"n":"زحل","e":"Saturn","c":["#FBE3A6","#D9AE5F"],"s":42,"ring":1,"d":"١٫٤ مليار كم","sz":"أعرض من الأرض ٩ مرات","day":"١٠ ساعات ونص","yr":10759,"mo":"أكثر من ١٤٠ قمرًا","t":"حوالي ١٤٠- درجة","r":9.4,"f":["مشهور بحلقاته الجميلة، وهي من قطع ثلج وصخر.","خفيف جدًا مع إنه ضخم، لو فيه حوض ماء بحجمه كان يطفو!","من أكثر الكواكب أقمارًا."]},{"n":"أورانوس","e":"Ur