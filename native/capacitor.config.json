{
  "appId": "com.wamdarc.siraj",
  "appName": "سراج | Siraj",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_siraj",
      "iconColor": "#5B4BDB"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
